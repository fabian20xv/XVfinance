{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "rewrites": [
    { "source": "/api/health", "destination": "/api/health" },
    { "source": "/api/smoke", "destination": "/api/smoke" },
    { "source": "/health", "destination": "/api?xv_path=/health" },
    { "source": "/v1/:path*", "destination": "/api?xv_path=/v1/:path*" }
  ]
}
