# XVfinance — copy to .env and fill placeholders. Never commit real keys.
#
# ONLY these two Supabase projects are allowed. Startup and CI fail loud on any other host/ref.
#   1. Parent/prod:         https://krcwpupbdizzjyydzaqp.supabase.co  (ref krcwpupbdizzjyydzaqp)
#   2. Develop/staging:     https://bkwhqfkosxnoffpsjcug.supabase.co  (ref bkwhqfkosxnoffpsjcug)
#      The develop ref is staging-only — never use it when APP_ENV/VERCEL_ENV=production.
#
# Set SUPABASE_URL to exactly one of the two URLs above.
SUPABASE_URL=https://krcwpupbdizzjyydzaqp.supabase.co
# Staging Tess (develop branch, staging-only):
# SUPABASE_URL=https://bkwhqfkosxnoffpsjcug.supabase.co
#
# Preview / Tess staging — develop ONLY (never parent krcwpupbdizzjyydzaqp on Preview):
#   SUPABASE_URL=https://bkwhqfkosxnoffpsjcug.supabase.co
#   SUPABASE_ANON_KEY=<develop anon>
#   APP_ENV=staging
#   SMOKE_SECRET=<shared with Tess>
#   SUPABASE_SERVICE_ROLE_KEY=<develop, server-only>   # seeds + API, never chat/client
#   SUPABASE_JWT_SECRET=<develop>                      # if JWT verify path is used
# See docs/tess-develop-seed.md. npm run seed:tess refuses parent.
# TESS_QA_PASSWORD=TessQa.Develop.Only.2026!
# TESS_SEED_DRY_RUN=1

# development | staging | production (VERCEL_ENV is used if APP_ENV is unset)
APP_ENV=development

# Publishable / anon key — safe for user-JWT (RLS) clients.
SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key

# Server-only. Never expose to chat tools, the model, or client bundles.
# Do not prefix with PUBLIC_ / NEXT_PUBLIC_ / VITE_ / GATSBY_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Server-only JWT secret for HS256 verification (optional if Auth /user check is used).
SUPABASE_JWT_SECRET=replace-with-jwt-secret

# Optional market data (CA-7). If unset/placeholder, chat tools use the stub provider.
# Not a service-role key. Never required for E0–E8 CI.
MARKET_API_KEY=replace-with-market-api-key-or-leave-stub
MARKET_API_BASE=

# POST /api/smoke (staging only). Header x-smoke-secret must match. Never enable in production.
SMOKE_SECRET=replace-with-smoke-secret

# Optional staging fixture for smoke auth + RLS read. Leave unset to skip those steps.
# SMOKE_USER_JWT=replace-with-staging-fixture-jwt
# SMOKE_DB_TABLE=replace_with_fixture_table
# SMOKE_DB_SELECT=id

# E11 agent chat (Preview/Production). Missing key fails loud — no fake replies.
OPENAI_API_KEY=replace-with-openai-api-key
# Optional spend-safe override (default gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# HTTP API (npm start → node src/index.js --serve)
PORT=8787

# E10 Next.js shell. Same allowlist as SUPABASE_URL.
# Preview/dev may use develop ref bkwhqfkosxnoffpsjcug; production must use parent krcwpupbdizzjyydzaqp.
NEXT_PUBLIC_SUPABASE_URL=https://krcwpupbdizzjyydzaqp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key
# Staging Tess (develop branch, staging-only):
# NEXT_PUBLIC_SUPABASE_URL=https://bkwhqfkosxnoffpsjcug.supabase.co
