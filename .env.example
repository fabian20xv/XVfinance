# XVfinance — copy to .env and fill placeholders. Never commit real keys.
#
# ONLY these two Supabase projects are allowed. Startup and CI fail loud on any other host/ref.
#   1. Parent/prod:         https://krcwpupbdizzjyydzaqp.supabase.co  (ref krcwpupbdizzjyydzaqp)
#   2. Develop/staging:     https://bkwhqfkosxnoffpsjcug.supabase.co  (ref bkwhqfkosxnoffpsjcug)
#      The develop ref is staging-only — never use it when APP_ENV/VERCEL_ENV=production.
#
# Set SUPABASE_URL to exactly one of the two URLs above.
SUPABASE_URL=https://krcwpupbdizzjyydzaqp.supabase.co
# Staging Tess (develop branch, staging-only):
# SUPABASE_URL=https://bkwhqfkosxnoffpsjcug.supabase.co

# development | staging | production (VERCEL_ENV is used if APP_ENV is unset)
APP_ENV=development

# Publishable / anon key — safe for user-JWT (RLS) clients.
SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key

# Server-only. Never expose to chat tools, the model, or client bundles.
# Do not prefix with PUBLIC_ / NEXT_PUBLIC_ / VITE_ / GATSBY_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# POST /api/smoke (staging only). Header x-smoke-secret must match. Never enable in production.
SMOKE_SECRET=replace-with-smoke-secret

# Optional staging fixture for smoke auth + RLS read. Leave unset to skip those steps.
# SMOKE_USER_JWT=replace-with-staging-fixture-jwt
# SMOKE_DB_TABLE=replace_with_fixture_table
# SMOKE_DB_SELECT=id

# HTTP listen port for `npm start` (default 3000)
# PORT=3000
