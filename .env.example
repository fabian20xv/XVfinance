# XVfinance — copy to .env and fill placeholders. Never commit real keys.
#
# ONLY this Supabase project is allowed. Startup and CI fail if SUPABASE_URL
# does not match host/ref krcwpupbdizzjyydzaqp.
SUPABASE_URL=https://krcwpupbdizzjyydzaqp.supabase.co

# Publishable / anon key — safe for user-JWT (RLS) clients.
SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key

# Server-only. Never expose to chat tools, the model, or client bundles.
# Do not prefix with PUBLIC_ / NEXT_PUBLIC_ / VITE_ / GATSBY_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
